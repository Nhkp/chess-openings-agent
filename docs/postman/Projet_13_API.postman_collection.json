  "item": [
    {
      "name": "Backend direct",
      "description": "Requetes vers FastAPI expose sur localhost:8000.",
      "item": [
        {
          "name": "Healthcheck",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/healthcheck",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "healthcheck"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('response has status', function () {",
                  "  pm.expect(json).to.have.property('status');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Moves by FEN",
          "request": {
            "method": "GET",
